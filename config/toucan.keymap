#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE 0
#define LOWER 1
#define RAISE 2
#define GAMING 3
#define GAMINGRAISE 4
#define GAMINGFKEYS 5

/ {
    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp ESC   &kp Q &kp W &kp F &kp P &kp B   &kp J &kp L     &kp U    &kp Y   &kp SEMI &kp BSLH
                &kp TAB   &kp A &kp R &kp S &kp T &kp G   &kp M &kp N     &kp E    &kp I   &kp O    &kp SQT
                &kp LCTRL &kp Z &kp X &kp C &kp D &kp V   &kp K &kp H     &kp COMMA &kp DOT &kp FSLH &kp LGUI
                                  &kp LSHFT &kp SPACE &mo LOWER   &mo RAISE &kp BSPC &kp RET
            >;
        };

        lower {
            display-name = "LOWER";
            bindings = <
                &kp GRAVE &kp F1 &kp F2 &kp F3  &kp F4   &kp PRCNT   &kp KP_NUMLOCK &kp KP_N7 &kp KP_N8 &kp KP_N9 &kp KP_MINUS &kp BSLH
                &kp TAB   &kp F5 &kp F6 &kp F7  &kp F8   &kp LBRC    &kp RBRC      &kp KP_N4 &kp KP_N5 &kp KP_N6 &kp KP_PLUS  &kp SQT
                &kp CAPS  &kp F9 &kp F10 &kp F11 &kp F12  &kp LBKT    &kp RBKT      &kp KP_N1 &kp KP_N2 &kp KP_N3 &kp KP_EQUAL &kp LGUI
                                    &kp LALT &kp SPACE &trans   &mo RAISE &kp BSPC &kp KP_N0
            >;
        };

        raise {
            display-name = "RAISE";
            bindings = <
                &kp GRAVE &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &kp UNDER   &kp EQUAL &kp LEFT &kp UP   &kp DOWN &kp RIGHT &kp PSCRN
                &bt BT_SEL 4 &kp N1 &kp N2 &kp N3    &kp N4    &kp N5     &kp N6    &kp N7   &kp N8   &kp N9   &kp N0    &tog GAMINGFKEYS
                &bt BT_CLR &out OUT_TOG &kp C_PP &kp C_PREV &kp C_NEXT &kp MINUS   &kp PLUS  &kp DEL  &mkp LCLK &mkp RCLK &kp KP_NUMLOCK &tog GAMING
                                  &kp LSHFT &kp SPACE &mo LOWER   &trans &kp BSPC &kp RET
            >;
        };

        gaming {
            display-name = "GAMING";
            bindings = <
                &kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5   &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp PSCRN
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P  &kp SQT
                &kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G    &kp Z  &kp X  &kp C  &kp V  &kp B  &tog GAMING
                                  &kp LALT &kp SPACE &mo GAMINGRAISE   &mo RAISE &kp BSPC &kp RET
            >;
        };

        gamingraise {
            display-name = "GAMING RAISE";
            bindings = <
                &trans &kp Z    &kp X &kp C &kp V &kp B   &trans &trans &trans &trans &trans &trans
                &trans &kp P    &kp O &kp I &kp U &kp Y   &trans &trans &trans &trans &trans &trans
                &trans &kp SEMI &kp L &kp K &kp J &kp H   &trans &trans &trans &trans &trans &trans
                               &trans &trans &trans   &trans &trans &trans
            >;
        };

        gamingfkeys {
            display-name = "GAMING FKEYS";
            bindings = <
                &kp ESC   &kp F1 &kp F2 &kp F3 &kp F4 &kp F5   &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp PSCRN
                &kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T    &kp Y  &kp U  &kp I  &kp O  &kp P   &tog GAMINGFKEYS
                &kp LSHFT &kp A  &kp S  &kp D  &kp F  &kp G    &kp Z  &kp X  &kp C  &kp V  &kp B   &tog GAMING
                                  &kp LALT &kp SPACE &mo GAMINGRAISE   &mo RAISE &kp BSPC &kp RET
            >;
        };
    };
};
